# --- required -------------------------------------------------------------
# The admin password. No default exists: this service is meant to sit on a
# public hostname, so a default credential would be the whole attack.
STUDIO_ADMIN_USERNAME=admin
STUDIO_ADMIN_PASSWORD=

# A WIS API key. Mint a DEDICATED one -- do not paste the wallpaper consumer's
# production key here. That key is `scheduling: normal` and shares a 60/hour
# rate bucket, so studio traffic would queue level with their product and could
# spend their limit:
#   cd ~/wis && python3 scripts/manage_keys.py mint --label story-studio --scheduling normal
STUDIO_WIS_KEY=

# --- optional -------------------------------------------------------------
STUDIO_WIS_URL=http://wis-api:8090
STUDIO_STORYBOARD_MODEL=minimax-h3-i2v
STUDIO_SINGLE_MODEL=minimax-h3-ref2v
STUDIO_SESSION_TTL_HOURS=12
STUDIO_MAX_UPLOAD_MB=16
STUDIO_MAX_STORYBOARD_SHOTS=12
STUDIO_DEFAULT_SHOT_SECONDS=5
STUDIO_USER_RENDERS_PER_HOUR=10
STUDIO_RETENTION_DAYS=14
# Set to 0 only if you are testing over plain http on the LAN.
STUDIO_COOKIE_SECURE=1
# The public address assistants connect to (the MCP endpoint is <this>/mcp and
# the instructions are at <this>/install). Blank = use whatever host each
# request arrives on, which is correct behind the tunnel.
STUDIO_PUBLIC_URL=

# Cloudflare tunnel token. Leave blank to run without a public hostname; the
# tunnel container only starts with `--profile tunnel`.
STUDIO_TUNNEL_TOKEN=
